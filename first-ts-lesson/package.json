{
  "name": "first-ts-lesson",
  "version": "1.0.0",
  "description": "A simple TypeScript project",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build:ts": "tsc",
    "copy:assets": "cp index.html test.html dist/ && cp -r public/ dist/ || true",
    "build": "npm run clean && npm run build:ts && npm run copy:assets",
    "start": "node server.js",
    "dev": "npm run build && node server.js",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": ["typescript", "learning"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.8.10",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "express": "^4.18.2"
  }
}
